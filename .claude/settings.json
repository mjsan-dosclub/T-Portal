{
  "permissions": {
    "deny": [
      "Edit(reference/**)",
      "Write(reference/**)",
      "Edit(docs/FACTS.md)",
      "Write(docs/FACTS.md)",
      "Edit(.claude/**)",
      "Write(.claude/**)",
      "Read(.env)",
      "Read(.env.local)",
      "Read(.env.production)"
    ],
    "ask": [
      "Bash(npm install:*)",
      "Bash(npm i:*)",
      "Bash(pnpm add:*)",
      "Bash(git push:*)",
      "Bash(npx prisma migrate:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [{ "type": "command", "command": "bash .claude/hooks/guard-bash.sh" }]
      }
    ]
  }
}
