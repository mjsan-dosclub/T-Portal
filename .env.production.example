# Production values for running migrations / seed / admin:create FROM YOUR LAPTOP against Supabase.
# Copy to .env.prod.local (git-ignored). Not ".env.production.local": Next.js auto-loads that name in
# production mode, so local test/production builds would silently pick up live settings. The same variables (except DIRECT_URL) go into Vercel → Settings → Environment Variables.

# Paste the URIs from Supabase → Connect, with [YOUR-PASSWORD] replaced and ?sslmode=require added at the end.
# DATABASE_URL = "Transaction pooler" URI (host ...pooler.supabase.com, port 6543). Used by the app on Vercel.
DATABASE_URL=""
# DIRECT_URL = "Session pooler" URI (same host, port 5432). Used only for migrations (not needed on Vercel).
DIRECT_URL=""
# Supabase → Project Settings → Database → SSL Configuration → Download certificate. Paste the PEM, or base64 of it:
#   base64 -i prod-ca-2021.crt | tr -d '\n'
DATABASE_CA_CERT=""

# NEW random values for production. Never reuse the local ones. Generate each with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep a copy in a password manager: losing APP_ENCRYPTION_KEY locks every admin and student out of Google Authenticator.
APP_ENCRYPTION_KEY=""
RECOVERY_PEPPER=""

# Your live URL, exactly as people open it (no trailing slash).
APP_ORIGIN="https://<your-project>.vercel.app"
