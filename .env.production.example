# Production values for running migrations / seed / admin:create FROM YOUR LAPTOP against Supabase.
# Copy to .env.production.local (git-ignored). The same variables (except DIRECT_URL) go into Vercel → Settings → Environment Variables.

# Supabase → Connect → "Transaction pooler" (port 6543). Used by the app on Vercel.
DATABASE_URL="postgresql://postgres.<project-ref>:<db-password>@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?sslmode=require"
# Supabase → Connect → "Session pooler" (port 5432). Used only for migrations (not needed on Vercel).
DIRECT_URL="postgresql://postgres.<project-ref>:<db-password>@aws-0-ap-south-1.pooler.supabase.com:5432/postgres?sslmode=require"
# Supabase → Project Settings → Database → SSL Configuration → Download certificate. Paste the PEM, or base64 of it:
#   base64 -i prod-ca-2021.crt | tr -d '\n'
DATABASE_CA_CERT=""

# NEW random values for production. Never reuse the local ones. Generate each with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep a copy in a password manager: losing APP_ENCRYPTION_KEY locks every admin and student out of Google Authenticator.
APP_ENCRYPTION_KEY=""
RECOVERY_PEPPER=""

# Your live URL, exactly as people open it (no trailing slash).
APP_ORIGIN="https://<your-project>.vercel.app"
