# Copy to .env and fill in. Never commit real values.
DATABASE_URL="postgresql://dos:dos-local-only@127.0.0.1:54329/dos_dev"
TEST_DATABASE_URL="postgresql://dos:dos-local-only@127.0.0.1:54329/dos_test"
# 32 random bytes, base64: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=""
# Pepper used when hashing recovery codes (32 random bytes, base64)
RECOVERY_PEPPER=""
# Set to "true" only behind HTTPS (production). Local http dev uses false.
COOKIE_SECURE="false"
APP_ORIGIN="http://localhost:3000"
