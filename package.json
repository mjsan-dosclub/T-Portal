{
  "name": "dos-club-talent-portal",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src tests e2e",
    "db:start": "node scripts/db.mjs",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "guard": "node scripts/guard/verify-ontology.mjs",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:dev": "tsx prisma/seed.dev.ts",
    "admin:create": "tsx scripts/create-super-admin.ts",
    "test": "vitest run",
    "typecheck": "next typegen >/dev/null && tsc --noEmit",
    "test:e2e": "playwright test",
    "postinstall": "prisma generate",
    "verify": "npm run lint && npm run typecheck && npm run guard && npm test",
    "verify:all": "npm run verify && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.2",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@radix-ui/react-dialog": "^1.2.0",
    "dotenv": "^18.0.7",
    "libphonenumber-js": "^1.13.15",
    "next": "16.4.0",
    "otplib": "^13.5.0",
    "papaparse": "^5.7.0",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22.20.5",
    "@types/papaparse": "^5.5.2",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "embedded-postgres": "^18.4.0-beta.17",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "prisma": "^7.10.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.3"
  }
}
