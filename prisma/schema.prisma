// DOS Club Talent Portal: Phase 1 schema (PRD §9).
// Phase 2 tables are intentionally absent; students.userId is a nullable placeholder (PRD §9).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────── Auth & admins ─────────────────────────

enum Role {
  SUPER_ADMIN
  ADMIN
  VIEWER
}

model AdminUser {
  id             String         @id @default(uuid())
  email          String         @unique
  name           String
  role           Role
  passwordHash   String
  totpSecretEnc  String?
  totpEnabled    Boolean        @default(false)
  totpLastStep   Int?
  failedAttempts Int            @default(0)
  lockedUntil    DateTime?
  lastLoginAt    DateTime?
  isActive       Boolean        @default(true)
  canExport      Boolean        @default(false) // only meaningful for VIEWER (D12)
  tablePrefs     Json?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  recoveryCodes  RecoveryCode[]
  sessions       Session[]

  @@map("admin_users")
}

model RecoveryCode {
  id       String    @id @default(uuid())
  adminId  String
  codeHash String
  usedAt   DateTime?
  admin    AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@map("recovery_codes")
}

model Session {
  id         String    @id // sha256(token) hex; raw token only lives in the cookie
  adminId    String
  mfaPassed  Boolean   @default(false)
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  expiresAt  DateTime
  ip         String?
  userAgent  String?
  admin      AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@map("sessions")
}

model RateLimit {
  key         String    @id // e.g. "login:ip:<ip>" or "login:acct:<id>:<ip>"
  count       Int       @default(0)
  windowStart DateTime  @default(now())
  lockedUntil DateTime?

  @@map("rate_limits")
}

// ───────────────────────── Master tables ─────────────────────────

model Institution {
  id        String    @id @default(uuid())
  name      String
  nameKey   String    @unique // lower(trim(collapse(name)))
  shortCode String?
  city      String?
  state     String?
  isPartner Boolean   @default(false)
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  students  Student[]

  @@map("institutions")
}

enum DegreeLevel {
  UG
  PG
  DIPLOMA
}

model Degree {
  id        String      @id @default(uuid())
  name      String
  nameKey   String      @unique
  level     DegreeLevel
  isActive  Boolean     @default(true)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  students  Student[]

  @@map("degrees")
}

model Department {
  id        String            @id @default(uuid())
  name      String
  nameKey   String            @unique
  shortCode String?
  isActive  Boolean           @default(true)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  aliases   DepartmentAlias[]
  students  Student[]

  @@map("departments")
}

model DepartmentAlias {
  id           String     @id @default(uuid())
  alias        String
  aliasKey     String     @unique // an alias can belong to only one department (MST-06)
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@index([departmentId])
  @@map("department_aliases")
}

model Batch {
  id               String            @id @default(uuid())
  batchCode        String
  codeKey          String            @unique
  year             Int
  startDate        DateTime?         @db.Date
  endDate          DateTime?         @db.Date
  isActive         Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  students         Student[]
  workshopSessions WorkshopSession[]

  @@map("batches")
}

model ColourTeam {
  id        String    @id @default(uuid())
  name      String
  nameKey   String    @unique
  hexColor  String?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  students  Student[]

  @@map("colour_teams")
}

model StudentStatus {
  id            String    @id @default(uuid())
  name          String
  nameKey       String    @unique
  color         String? // token key, e.g. "accent", "primary", "deep", "muted"
  isActiveState Boolean   @default(true)
  isDefault     Boolean   @default(false)
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  students      Student[]

  @@map("student_statuses")
}

// ───────────────────────── Students ─────────────────────────

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

model Student {
  id              String                  @id @default(uuid())
  studentCode     String                  @unique
  fullName        String
  email           String                  @unique
  phone           String                  @unique
  gender          Gender?
  dateOfBirth     DateTime?               @db.Date
  institutionId   String
  degreeId        String
  departmentId    String
  yearOfStudy     Int?
  graduationYear  Int
  batchId         String
  colourTeamId    String?
  statusId        String
  city            String?
  state           String?
  linkedinUrl     String?
  githubUrl       String?
  notes           String?
  targetRoleId    String? // D5: optional link to ontology role
  userId          String? // Phase 2 placeholder: future student login. No FK yet.
  version         Int                     @default(1)
  createdAt       DateTime                @default(now())
  createdById     String?
  updatedAt       DateTime                @updatedAt
  updatedById     String?
  deletedAt       DateTime?
  deletedById     String?
  institution     Institution             @relation(fields: [institutionId], references: [id])
  degree          Degree                  @relation(fields: [degreeId], references: [id])
  department      Department              @relation(fields: [departmentId], references: [id])
  batch           Batch                   @relation(fields: [batchId], references: [id])
  colourTeam      ColourTeam?             @relation(fields: [colourTeamId], references: [id])
  status          StudentStatus           @relation(fields: [statusId], references: [id])
  targetRole      OntRole?                @relation(fields: [targetRoleId], references: [id])
  portalUser      StudentUser?
  portfolioUrl    String? // student-editable (PRF-1)
  skills          StudentSkill[]
  projects        StudentProject[]
  profile         StudentProfile?
  educations      StudentEducation[]
  internships     StudentInternship[]
  certifications  StudentCertification[]
  accomplishments StudentAccomplishment[]
  tools           StudentTool[]
  resume          StudentResume?
  attendance      Attendance[]

  @@index([deletedAt])
  @@index([fullName])
  @@index([institutionId])
  @@index([departmentId])
  @@index([degreeId])
  @@index([batchId])
  @@index([statusId])
  @@index([colourTeamId])
  @@index([graduationYear])
  @@index([createdAt])
  @@map("students")
}

model CodeCounter {
  year Int @id
  last Int @default(0)

  @@map("code_counters")
}

// ───────────────────────── Uploads ─────────────────────────

enum UploadStatus {
  PREVIEW
  IMPORTING
  COMPLETED
  FAILED
}

enum UploadRowStatus {
  VALID
  DUPLICATE_FILE
  DUPLICATE_DB
  ERROR
}

model UploadJob {
  id           String       @id @default(uuid())
  kind         String // "students" | "master:<type>"
  fileName     String
  uploadedById String
  status       UploadStatus @default(PREVIEW)
  total        Int          @default(0)
  valid        Int          @default(0)
  duplicates   Int          @default(0)
  errors       Int          @default(0)
  imported     Int          @default(0)
  updated      Int          @default(0)
  skipped      Int          @default(0)
  failed       Int          @default(0)
  mapping      Json?
  failure      String?
  createdAt    DateTime     @default(now())
  completedAt  DateTime?
  rows         UploadRow[]

  @@index([uploadedById, createdAt])
  @@map("upload_jobs")
}

model UploadRow {
  id                 String          @id @default(uuid())
  jobId              String
  rowNo              Int
  raw                Json
  normalized         Json?
  status             UploadRowStatus
  errors             Json?
  duplicateStudentId String?
  decision           String? // "skip" | "update" for DUPLICATE_DB rows
  job                UploadJob       @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, rowNo])
  @@map("upload_rows")
}

// ───────────────────────── Audit ─────────────────────────

model AuditLog {
  id        BigInt   @id @default(autoincrement())
  actorId   String?
  action    String
  entity    String
  entityId  String?
  before    Json?
  after     Json?
  reason    String?
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([actorId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ───────────────────────── Ontology (read-only, seeded) ─────────────────────────

model OntCategory {
  id            Int              @id // the leading number, e.g. 1 for "1. Strategy, …"
  name          String           @unique
  subcategories OntSubcategory[]
  roles         OntRole[]

  @@map("ontology_categories")
}

model OntSubcategory {
  id         Int         @id @default(autoincrement())
  code       String      @unique // "1.1"
  name       String
  categoryId Int
  category   OntCategory @relation(fields: [categoryId], references: [id])
  skills     OntSkill[]

  @@map("ontology_subcategories")
}

model OntSkill {
  code          String         @id
  name          String
  description   String
  source        String // stored as-is, not displayed (D11); "DOS Club" for admin-added skills
  isActive      Boolean        @default(true) // false = retired (ONT-EDIT)
  retiredAt     DateTime?
  retiredReason String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @default(now()) @updatedAt
  subcategoryId Int
  subcategory   OntSubcategory @relation(fields: [subcategoryId], references: [id])
  roleSkills    OntRoleSkill[]
  studentSkills StudentSkill[]

  @@map("ontology_skills")
}

model OntRole {
  id            String           @id @default(uuid()) // surrogate key; source has none (FACTS F1.13)
  name          String           @unique
  categoryId    Int
  track         String
  levelMin      Int
  levelMax      Int
  isActive      Boolean          @default(true) // false = retired (ONT-EDIT)
  retiredAt     DateTime?
  retiredReason String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @default(now()) @updatedAt
  category      OntCategory      @relation(fields: [categoryId], references: [id])
  skills        OntRoleSkill[]
  roadmapSteps  OntRoadmapStep[]
  students      Student[]

  @@map("ontology_roles")
}

model OntRoleSkill {
  roleId    String
  skillCode String
  level     Int
  role      OntRole  @relation(fields: [roleId], references: [id], onDelete: Cascade)
  skill     OntSkill @relation(fields: [skillCode], references: [code])

  @@id([roleId, skillCode])
  @@index([skillCode])
  @@map("ontology_role_skills")
}

model OntRoadmapStep {
  id         Int     @id @default(autoincrement())
  roleId     String
  sort       Int
  levelNum   Int
  levelLabel String
  whatYouDo  String
  tools      String
  next       String
  role       OntRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, sort])
  @@map("ontology_roadmap_steps")
}

model OntLevel {
  n           Int    @id
  name        String
  description String

  @@map("ontology_levels")
}

model OntWorkshop {
  n                Int               @id
  title            String
  roleText         String
  workshopSessions WorkshopSession[]
  attendances      Attendance[]

  @@map("ontology_workshops")
}

// ───────────────────────── Phase 2: student portal access (PH2-1..4) ─────────────────────────
// Kept fully separate from admin auth: own table, own sessions, own cookie.

model StudentUser {
  id                    String                @id @default(uuid())
  studentId             String                @unique
  passwordHash          String
  totpSecretEnc         String?
  totpEnabled           Boolean               @default(false)
  totpLastStep          Int?
  mustChangePassword    Boolean               @default(false) // after an admin-issued one-time password (PH2-7)
  tempPasswordExpiresAt DateTime?
  lastLoginAt           DateTime?
  activatedAt           DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  student               Student               @relation(fields: [studentId], references: [id], onDelete: Cascade)
  recoveryCodes         StudentRecoveryCode[]
  sessions              StudentSession[]

  @@map("student_users")
}

model StudentRecoveryCode {
  id            String      @id @default(uuid())
  studentUserId String
  codeHash      String
  usedAt        DateTime?
  user          StudentUser @relation(fields: [studentUserId], references: [id], onDelete: Cascade)

  @@index([studentUserId])
  @@map("student_recovery_codes")
}

model StudentSession {
  id            String      @id // sha256(token)
  studentUserId String
  mfaPassed     Boolean     @default(false)
  createdAt     DateTime    @default(now())
  lastSeenAt    DateTime    @default(now())
  expiresAt     DateTime
  ip            String?
  userAgent     String?
  user          StudentUser @relation(fields: [studentUserId], references: [id], onDelete: Cascade)

  @@index([studentUserId])
  @@map("student_sessions")
}

// ───────────────────────── Phase 2 steps 2–4: profile, skills, attendance (PRF-1, PRF-2, ATT-1) ─────────────────────────

/// A student's level on one skill. selfLevel 0 = "not yet". verifiedLevel (admin) wins over selfLevel for gaps.
model StudentSkill {
  studentId     String
  skillCode     String
  selfLevel     Int       @default(0)
  verifiedLevel Int?
  verifiedById  String?
  verifiedAt    DateTime?
  updatedAt     DateTime  @updatedAt
  student       Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  skill         OntSkill  @relation(fields: [skillCode], references: [code])

  @@id([studentId, skillCode])
  @@index([skillCode])
  @@map("student_skills")
}

model StudentProject {
  id          String   @id @default(uuid())
  studentId   String
  title       String
  description String
  url         String?
  skillCodes  String[]
  projectType String   @default("ACADEMIC") // ACADEMIC | PERSONAL | INTERNSHIP | OPEN_SOURCE | HACKATHON
  role        String?
  startMonth  String? // YYYY-MM
  endMonth    String? // YYYY-MM; null = ongoing
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@map("student_projects")
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  EXCUSED
}

/// One workshop day (1–27) held for one DOS Club batch.
model WorkshopSession {
  batchId     String
  workshopN   Int
  heldOn      DateTime?   @db.Date
  updatedById String?
  updatedAt   DateTime    @updatedAt
  batch       Batch       @relation(fields: [batchId], references: [id], onDelete: Cascade)
  workshop    OntWorkshop @relation(fields: [workshopN], references: [n])

  @@id([batchId, workshopN])
  @@map("workshop_sessions")
}

model Attendance {
  studentId  String
  workshopN  Int
  status     AttendanceStatus
  markedById String?
  markedAt   DateTime         @default(now())
  student    Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  workshop   OntWorkshop      @relation(fields: [workshopN], references: [n])

  @@id([studentId, workshopN])
  @@index([workshopN])
  @@map("attendance")
}

// ───────────────────────── Detailed fresher profile (PRF-3) ─────────────────────────

model StudentProfile {
  studentId          String    @id
  headline           String?
  summary            String?
  hometown           String?
  languages          Json? // [{ name, read, write, speak }]
  preferredRoleIds   String[]
  preferredLocations String[]
  jobTypes           String[] // FULL_TIME | INTERNSHIP | APPRENTICESHIP
  workModes          String[] // ONSITE | HYBRID | REMOTE
  expectedCtcLpa     Float?
  availableFrom      DateTime? @db.Date
  willingToRelocate  Boolean?
  updatedAt          DateTime  @updatedAt
  student            Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@map("student_profiles")
}

model StudentEducation {
  id             String   @id @default(uuid())
  studentId      String
  level          String // CLASS_10 | CLASS_12 | DIPLOMA | UG | PG | DOCTORATE | OTHER
  board          String? // board (school) or university
  institution    String
  course         String?
  specialization String?
  medium         String?
  startYear      Int?
  endYear        Int?
  ongoing        Boolean  @default(false)
  gradingSystem  String // PERCENTAGE | CGPA_10 | CGPA_4 | PASS
  score          Float?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  student        Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@map("student_educations")
}

model StudentInternship {
  id             String   @id @default(uuid())
  studentId      String
  organisation   String
  role           String
  location       String?
  workMode       String? // ONSITE | HYBRID | REMOTE
  startMonth     String // YYYY-MM
  endMonth       String? // null = ongoing
  stipendMonthly Int?
  description    String
  skillCodes     String[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  student        Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@map("student_internships")
}

model StudentCertification {
  id           String    @id @default(uuid())
  studentId    String
  name         String
  issuer       String
  issueDate    DateTime? @db.Date
  expiryDate   DateTime? @db.Date
  noExpiry     Boolean   @default(false)
  credentialId String?
  url          String?
  skillCodes   String[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  student      Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@map("student_certifications")
}

model StudentAccomplishment {
  id          String    @id @default(uuid())
  studentId   String
  type        String // AWARD | HACKATHON | PUBLICATION | OPEN_SOURCE | VOLUNTEERING | OTHER
  title       String
  issuer      String? // organiser / publisher / project
  date        DateTime? @db.Date
  url         String?
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  student     Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@map("student_accomplishments")
}

/// Technical skills / tools (free text, like job portals' "IT skills"), alongside structured ontology ratings.
model StudentTool {
  id               String  @id @default(uuid())
  studentId        String
  name             String
  nameKey          String
  version          String?
  experienceMonths Int     @default(0)
  lastUsedYear     Int?
  student          Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, nameKey])
  @@map("student_tools")
}

model StudentResume {
  studentId  String   @id
  fileName   String
  sizeBytes  Int
  data       Bytes
  uploadedAt DateTime @default(now())
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@map("student_resumes")
}
